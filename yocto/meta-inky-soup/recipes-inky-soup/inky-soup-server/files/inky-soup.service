<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">Inky Soup on %h</name>
  <service protocol="ipv4">
    <type>_inky-soup._tcp</type>
    <port>8000</port>
    <txt-record>api=1</txt-record>
    <txt-record>path=/api/device</txt-record>
  </service>
</service-group>
